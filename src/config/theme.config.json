{
  "colors": {
    "primary": "#008C4F",
    "primaryLight": "#00A85D",
    "primaryDark": "#006B3C",
    "secondary": "#3E88F7",
    "success": "#34C759",
    "warning": "#FF9500",
    "error": "#FF3B30",
    "info": "#5856D6"
  },
  "borderRadius": {
    "none": "0px",
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "20px",
    "2xl": "24px",
    "full": "9999px"
  },
  "fontFamily": {
    "sans": "Inter, system-ui, -apple-system, BlinkMacSystemFont, sans-serif",
    "mono": "JetBrains Mono, Menlo, Monaco, monospace"
  },
  "fontMode": "inter",
  "scale": {
    "normal": 1.0,
    "large": 1.15,
    "extraLarge": 1.3
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "2xl": "32px",
    "3xl": "48px"
  },
  "shadows": {
    "sm": "0 1px 2px rgba(0, 0, 0, 0.05)",
    "md": "0 4px 12px rgba(0, 0, 0, 0.08)",
    "lg": "0 8px 24px rgba(0, 0, 0, 0.12)",
    "xl": "0 12px 32px rgba(0, 0, 0, 0.16)"
  },
  "animation": {
    "durationFast": "100ms",
    "durationNormal": "200ms",
    "durationSlow": "300ms",
    "easeSpring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
    "easeSmooth": "cubic-bezier(0.4, 0, 0.2, 1)"
  },
  "components": {
    "button": {
      "borderRadius": "md",
      "defaultSize": "md",
      "defaultVariant": "primary"
    },
    "input": {
      "borderRadius": "md",
      "defaultSize": "md"
    },
    "select": {
      "borderRadius": "md",
      "defaultSize": "md"
    },
    "card": {
      "borderRadius": "xl",
      "defaultVariant": "default",
      "defaultPadding": "md"
    },
    "modal": {
      "borderRadius": "2xl",
      "defaultSize": "md"
    },
    "toast": {
      "borderRadius": "lg"
    },
    "iconButton": {
      "borderRadius": "md",
      "defaultSize": "md"
    },
    "badge": {
      "borderRadius": "sm"
    },
    "avatar": {
      "defaultSize": "md"
    },
    "switch": {
      "defaultSize": "md"
    }
  },
  "responsive": {
    "breakpoints": {
      "sm": 640,
      "md": 768,
      "lg": 1024,
      "xl": 1280,
      "2xl": 1536
    },
    "sizeScale": {
      "compact": {
        "description": "For small screens or dense UI",
        "scale": 0.875,
        "buttonSize": "sm",
        "inputSize": "sm",
        "spacing": "tight"
      },
      "normal": {
        "description": "Default sizing",
        "scale": 1.0,
        "buttonSize": "md",
        "inputSize": "md",
        "spacing": "normal"
      },
      "comfortable": {
        "description": "For touch-friendly or elderly users",
        "scale": 1.15,
        "buttonSize": "lg",
        "inputSize": "lg",
        "spacing": "relaxed"
      },
      "large": {
        "description": "Maximum accessibility",
        "scale": 1.3,
        "buttonSize": "lg",
        "inputSize": "lg",
        "spacing": "relaxed"
      }
    }
  }
}